{
    "name": "nezbot-calibrate",
    "version": "0.20261006.1",
    "description": "Calibration programs for a Nezha robot driven by DiffDrive: measure the wheels and the track on a line sheet, then dump the result as data or as code.",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "nezha-diffdrive": "github:League-Robotics/pxt-nezha-diffdrive#v1.20261006.1"
    },
    "files": [
        "README.md",
        "src/shapes.ts",
        "src/tours.ts",
        "src/linetrack.ts",
        "src/calwheels.ts",
        "src/calturn.ts",
        "src/calibrate.ts"
    ],
    "testFiles": [
        "test.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj",
    "yotta": {
        "config": {
            "microbit_radio_max_packet_size": 250,
            "device_ble": 0
        }
    },
    "disablesVariants": [
        "mbdal"
    ]
}
